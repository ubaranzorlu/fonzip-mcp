# Fonzip API kimlik bilgileri
# Fonzip > Ayarlar > Gelismis > Fonzip API > "API anahtari olustur"
FONZIP_CLIENT_ID=
FONZIP_CLIENT_SECRET=

# Hazir bir token varsa client_credentials akisi atlanir (opsiyonel)
# FONZIP_ACCESS_TOKEN=

# API adresi (opsiyonel)
# FONZIP_BASE_URL=https://fonzip.com/api/v2

# Tool semasi: full (varsayilan, ~70 KB) veya compact (~22 KB)
# FONZIP_SCHEMA_MODE=full

# Token onbellegi. Fonzip ayni anda tek token verdigi icin acik birakin.
# "off" ile kapatilir.
# FONZIP_TOKEN_CACHE=~/.cache/fonzip-mcp/tokens.json

# FONZIP_TIMEOUT_MS=30000
# FONZIP_MAX_RETRIES=3

# Cloudflare, User-Agent'siz istekleri 1010 koduyla engelliyor. Bos birakmayin.
# FONZIP_USER_AGENT=fonzip-mcp/0.1.0
